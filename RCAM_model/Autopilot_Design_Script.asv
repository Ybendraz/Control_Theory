%% Longitudinal autopilot design:
% Plotting open loop poles and zeros:
%zpk(RCAM_OP1_LONG)
plot(eig(RCAM_OP1_LONG),'x','LineWidth',2)
grid on
xlabel("Re")
ylabel("Im")

% the pitch is only impacted by the elevator input, we can start by setting
% the q, theta loop:
G_q_dT = tf(RCAM_OP1_LONG(4,2));
